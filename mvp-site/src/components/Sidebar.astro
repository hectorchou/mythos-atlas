---
interface Props {
  entries: any[];
  base: string;
  activeId?: string;
}

const { entries, base, activeId } = Astro.props;

// Group by culture_path top level
const grouped: Record<string, { id: string; name: string; active: boolean }[]> = {};
for (const e of entries) {
  const top = e.data.culture_path?.split('/')[0] ?? 'Other';
  if (!grouped[top]) grouped[top] = [];
  grouped[top].push({
    id: e.data.id,
    name: e.data.name_primary,
    active: e.data.id === activeId,
  });
}

// Sort groups by entry count descending
const sortedGroups = Object.entries(grouped)
  .map(([k, v]) => ({ culture: k, items: v.sort((a, b) => a.name.localeCompare(b.name, 'zh')) }))
  .sort((a, b) => b.items.length - a.items.length);

// Culture group icons (Unicode)
const icons: Record<string, string> = {
  '亚洲': '🏯', '非洲': '🌍', '美洲': '🗽', '欧洲': '⚔️',
  '中东': '🕌', '大洋洲': '🌊', '南亚': '☸️',
};
function getIcon(c: string) { return icons[c] || '📖'; }
---

<nav class="sidebar-nav">
  <div class="sidebar-header">
    <span class="sidebar-title">文化体系</span>
    <span class="sidebar-total">{entries.length} 条</span>
  </div>

  {sortedGroups.map(({ culture, items }) => (
    <details class="culture-group" open={items.some(i => i.active) || items.length <= 30}>
      <summary class="culture-summary">
        <span class="culture-icon">{getIcon(culture)}</span>
        <span class="culture-name">{culture}</span>
        <span class="culture-count">{items.length}</span>
      </summary>
      <ul class="culture-list">
        {items.map(item => (
          <li>
            <a
              href={`${base}/entries/${item.id}`}
              class:list={['nav-link', { active: item.active }]}
            >{item.name}</a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</nav>

<style>
  .sidebar-nav {
    padding: .8rem 0;
    font-size: .88rem;
  }
  .sidebar-header {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: .4rem 1rem .8rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: .5rem;
  }
  .sidebar-title {
    font-weight: 700; font-size: .95rem;
    color: var(--color-accent-dark);
    font-family: var(--font-serif);
  }
  .sidebar-total { color: var(--color-text-muted); font-size: .78em; }

  .culture-group { margin: .15rem 0; }
  .culture-summary {
    display: flex; align-items: center; gap: .45rem;
    padding: .45rem 1rem; cursor: pointer;
    font-weight: 600; color: var(--color-text);
    border-radius: 0;
    list-style: none;
    user-select: none;
    transition: background .15s;
  }
  .culture-summary::-webkit-details-marker { display: none; }
  .culture-summary::after {
    content: '▸'; margin-left: auto; font-size: .7em;
    color: var(--color-text-muted);
    transition: transform .2s;
  }
  details[open] > .culture-summary::after { transform: rotate(90deg); }
  .culture-summary:hover { background: var(--color-sidebar-active); }

  .culture-icon { font-size: 1em; width: 1.2em; text-align: center; }
  .culture-name { flex: 1; }
  .culture-count {
    font-size: .7em; color: var(--color-text-muted);
    background: var(--color-border-light);
    padding: .1em .5em; border-radius: 10px;
    font-weight: 400;
  }

  .culture-list {
    list-style: none; padding: 0 0 .3rem 0;
    max-height: 50vh; overflow-y: auto;
  }
  .nav-link {
    display: block;
    padding: .28rem 1rem .28rem 2.2rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background .12s, color .12s;
  }
  .nav-link:hover {
    background: var(--color-sidebar-active);
    color: var(--color-text);
    text-decoration: none;
  }
  .nav-link.active {
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    border-radius: 2px;
  }
</style>
