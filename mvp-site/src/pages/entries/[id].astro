---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  return entries.map(e => ({ params: { id: e.data.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${d.name_primary} · Mythos Atlas`} activeId={d.id}>
  <article class="entry">
    <nav class="breadcrumb">
      <a href={`${base}/`}>首页</a>
      <span class="sep">/</span>
      <a href={`${base}/#culture-${d.culture_path?.split('/')[0]}`}>{d.culture_path?.split('/')[0]}</a>
      <span class="sep">/</span>
      <span class="current">{d.name_primary}</span>
    </nav>

    <h1>{d.name_primary} <span class="original">{d.name_original}</span></h1>
    <div class="meta-line">
      {d.culture_path} · {d.entity_type}
      · <span class={`confidence confidence-${d.confidence}`}>{d.confidence}</span>
      {d.first_recorded && <span> · {d.first_recorded}</span>}
    </div>

    {d.hero_image && (
      <figure class="hero">
        <img src={`${base}${d.hero_image}`} alt={d.hero_image_alt || d.name_primary} loading="lazy" />
        {d.hero_image_credit && <figcaption class="hero-credit">{d.hero_image_credit}</figcaption>}
      </figure>
    )}

    <div class="summary-box">{d.summary}</div>

    <table class="meta-table">
      {d.name_aliases && d.name_aliases.length > 0 && <tr><td>别称</td><td>{d.name_aliases.join(' / ')}</td></tr>}
      {d.era && <tr><td>时代</td><td>{d.era}</td></tr>}
      {d.geo_region && <tr><td>地理</td><td>{d.geo_region}</td></tr>}
      {d.first_recorded && <tr><td>最早文献</td><td>{d.first_recorded}</td></tr>}
      {d.first_attested_year && <tr><td>始证年代</td><td>{d.first_attested_year}</td></tr>}
      {d.attributes && d.attributes.length > 0 && (
        <tr><td>特征</td><td class="attr-list">{d.attributes.slice(0, 20).map(a => String(a)).join(' · ')}{d.attributes.length > 20 ? ' ...' : ''}</td></tr>
      )}
      {d.epithets && d.epithets.length > 0 && <tr><td>头衔</td><td>{d.epithets.map(e => String(e)).join(' · ')}</td></tr>}
      {d.domain && <tr><td>领域</td><td>{Array.isArray(d.domain) ? d.domain.join(', ') : d.domain}</td></tr>}
      {d.parents && d.parents.length > 0 && <tr><td>父母</td><td>{d.parents.map(p => String(p)).join(' · ')}</td></tr>}
      {d.consort && d.consort.length > 0 && <tr><td>配偶</td><td>{d.consort.map(c => String(c)).join(' · ')}</td></tr>}
      {d.children && d.children.length > 0 && <tr><td>子嗣</td><td>{d.children.map(c => String(c)).join(' · ')}</td></tr>}
      {d.cult_center && d.cult_center.length > 0 && <tr><td>崇拜中心</td><td>{d.cult_center.map(c => String(c)).join(' · ')}</td></tr>}
    </table>

    <div class="content-body">
      <Content />
    </div>

    <section class="sources-section">
      <h2>一手来源</h2>
      {d.primary_sources?.map(s => (
        <div class="source">
          <div class="source-head">
            <span class="source-type">{s.type}</span>
            <strong>{s.title}</strong>
            {s.author && <span> · {s.author}</span>}
            {s.year && <span> ({s.year})</span>}
          </div>
          {s.url && <div class="source-url"><a href={s.url} target="_blank" rel="noopener">{s.url}</a></div>}
          {s.note && <div class="source-note">{s.note}</div>}
        </div>
      ))}
    </section>

    {d.secondary_sources && d.secondary_sources.length > 0 && (
      <section class="sources-section">
        <h2>二手研究</h2>
        {d.secondary_sources.map(s => (
          <div class="source">
            <div class="source-head">
              <span class="source-type">{s.type}</span>
              <strong>{s.title}</strong>
              {s.author && <span> · {s.author}</span>}
              {s.year && <span> ({s.year})</span>}
            </div>
            {s.url && <div class="source-url"><a href={s.url} target="_blank" rel="noopener">{s.url}</a></div>}
          </div>
        ))}
      </section>
    )}

    {d.parallel_motifs && d.parallel_motifs.length > 0 && (
      <section class="sources-section">
        <h2>跨文化对照</h2>
        {d.parallel_motifs.map(p => (
          <div class="parallel-item">
            <a href={`${base}/entries/${p.entry_id}`}>{p.entry_id}</a>
            {p.relation && <span> — {p.relation}</span>}
          </div>
        ))}
      </section>
    )}

    <footer class="entry-footer">
      <p>录入：{d.curator} · 更新：{d.updated_at} · LLM 参与：{d.llm_assisted ? '是' : '否'} · 状态：{d.review_status}</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .entry { max-width: 780px; }

  .breadcrumb {
    font-size: .82em; color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .breadcrumb a { color: var(--color-accent-dark); }
  .breadcrumb .sep { margin: 0 .4rem; }
  .breadcrumb .current { color: var(--color-text-secondary); }

  h1 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    margin-bottom: .3rem;
    line-height: 1.3;
  }
  .original {
    color: var(--color-accent-dark);
    font-size: .75em;
    font-weight: 400;
  }
  .meta-line {
    color: var(--color-text-muted);
    font-size: .88rem;
    margin-bottom: 1.2rem;
  }
  .confidence-attested { color: #2a7f3f; font-weight: 600; }
  .confidence-documented { color: #b8860b; }
  .confidence-folk { color: #808080; }
  .confidence-speculative { color: #c94f4f; }

  .hero { margin: 1rem 0 1.5rem; }
  .hero img {
    width: 100%; height: auto;
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 12px var(--color-shadow-hover);
  }
  .hero-credit {
    text-align: right; font-size: .72em;
    color: var(--color-text-muted); margin-top: .3rem;
  }

  .summary-box {
    background: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    padding: 1rem 1.2rem;
    margin: 1rem 0 1.5rem;
    font-size: .92rem;
    line-height: 1.7;
  }

  .meta-table {
    width: 100%; border-collapse: collapse;
    margin: 1rem 0 1.5rem; font-size: .88rem;
  }
  .meta-table td {
    padding: .4rem .6rem;
    border-bottom: 1px solid var(--color-border-light);
    vertical-align: top;
  }
  .meta-table td:first-child {
    color: var(--color-text-muted);
    width: 7em; white-space: nowrap;
  }
  .attr-list { font-size: .85em; line-height: 1.6; }

  .content-body {
    line-height: 1.8;
    font-size: .95rem;
  }
  .content-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-accent-dark);
    margin: 2rem 0 .8rem;
    padding-bottom: .3rem;
    border-bottom: 1px solid var(--color-border-light);
  }
  .content-body :global(h3) {
    font-size: 1.05rem;
    margin: 1.5rem 0 .5rem;
  }
  .content-body :global(p) { margin: .6rem 0; }
  .content-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: .5rem 1rem; margin: 1rem 0;
    background: var(--color-border-light);
    font-style: italic;
  }
  .content-body :global(table) {
    width: 100%; border-collapse: collapse;
    margin: 1rem 0; font-size: .88rem;
  }
  .content-body :global(th),
  .content-body :global(td) {
    padding: .4rem .6rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }
  .content-body :global(th) {
    background: var(--color-sidebar-bg);
    font-weight: 600;
  }

  .sources-section {
    margin-top: 2rem;
  }
  .sources-section h2 {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-accent-dark);
    margin-bottom: .8rem;
  }
  .source {
    background: var(--color-surface);
    padding: .7rem 1rem;
    margin: .5rem 0;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-accent-dark);
    font-size: .88rem;
  }
  .source-type {
    display: inline-block;
    background: var(--color-accent-dark);
    color: #fff; font-size: .68em;
    padding: .1em .5em;
    border-radius: 2px;
    margin-right: .5em;
    text-transform: uppercase;
  }
  .source-url { margin-top: .2rem; font-size: .82em; word-break: break-all; }
  .source-url a { color: var(--color-accent-dark); }
  .source-note { font-size: .82em; color: var(--color-text-muted); margin-top: .25rem; }

  .parallel-item {
    padding: .4rem .8rem;
    background: var(--color-border-light);
    margin: .3rem 0;
    border-radius: var(--radius-sm);
    font-size: .88rem;
  }
  .parallel-item a { color: var(--color-accent-dark); font-weight: 500; }

  .entry-footer {
    margin-top: 3rem; padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted); font-size: .78em;
  }
</style>
